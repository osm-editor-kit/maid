    {
      "id": "radnetz-tilda-0.7",
      "title": "TILDA tagging 0.7.0: a segregated cycle track is merged with the sidewalk; construction states",
      "commits": [
        "66721e631bd1246f6bdd03dca3ecfcbac426c4f1",
        "90b00d6a1578352bdfa33491ce03b4304fe416ea"
      ],
      "area": "sidepaths",
      "decision": "adopted",
      "reason": "Generic tagging logic of the TILDA packages, valid for all of Germany. Maid's extract-and-merge now extracts a cycle track with cycleway:<side>:segregated=yes as the cycleway line of two lines and merges it into a segregated foot and cycle path; without a sidewalk way it becomes a segregated path of its own, and when only one of road and sidewalk is under construction both stay as two lines (traffic_mode:<side>=foot). 'Extract cycle track' on a segregated side runs that merge. A plain cycle track whose sidewalk differs in its construction state is refused with its own sentence (different_lifecycle). Not ported: the fork's flash that names the case (Maid's edit menu has no flash; the preview shows the lines).",
      "decidedBy": "Tobias",
      "date": "2026-11-20",
      "ours": ["c73e5b9feeef6672a13dfc7f17c4cd806aaecded"],
