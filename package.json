{
  "name": "maid",
  "private": true,
  "license": "ISC",
  "type": "module",
  "workspaces": ["apps/*", "packages/*", "tools/*"],
  "scripts": {
    "dev": "bun run --parallel dev:*",
    "dev:maid": "bun run --cwd apps/maid dev",
    "dev:api": "bun tools/mock-osm-api/server.ts",
    "fixtures-build": "bun tools/fixtures/build.ts",
    "type-check": "tsc --noEmit",
    "test-run": "bun test",
    "check": "bun run --parallel type-check test-run"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/bun": "^1.4.2",
    "typescript": "^7.0.2"
  }
}
