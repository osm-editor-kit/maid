{
  "name": "maid",
  "private": true,
  "license": "ISC",
  "workspaces": [
    "apps/*",
    "packages/*",
    "tools/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "bun run --parallel dev-maid dev-bicycle dev:api",
    "dev:api": "bun tools/mock-osm-api/server.ts",
    "dev-maid": "bun run --cwd apps/maid dev",
    "dev-bicycle": "bun run --cwd apps/maid-bicycle dev",
    "fixtures-build": "bun tools/fixtures/build.ts",
    "type-check": "tsc -b packages/model && tsc --noEmit && tsc --noEmit -p packages/core/tsconfig.test.json",
    "test-run": "bun test",
    "check": "bun run --parallel type-check lint format test-run",
    "bench": "bun tools/bench/run.ts",
    "bench-smoke": "bun tools/bench/run.ts --scene small --repeat 1 --label smoke",
    "bench-report": "bun tools/bench/report.ts",
    "refs-setup": "bun tools/refs/id/setup.ts && bun tools/refs/rapid/setup.ts && bun tools/refs/copy-sprites.ts",
    "refs-serve": "bun run --parallel refs-serve:*",
    "refs-serve:id": "bun tools/refs/id/serve.ts",
    "refs-serve:rapid": "bun tools/refs/rapid/serve.ts",
    "compare": "bun apps/compare/start.ts",
    "check-draw": "bun tools/bench/draw-check.ts",
    "check-edit": "bun tools/bench/edit-check.ts",
    "check-validation": "bun tools/bench/validation-check.ts",
    "check-undo": "bun tools/bench/undo.ts",
    "bench-validation": "bun packages/validation/bench/validation.bench.ts",
    "check-filters": "bun tools/bench/filters-check.ts",
    "check-journal": "bun tools/bench/journal-check.ts",
    "check-tags": "bun tools/bench/tags-check.ts",
    "check-interactions": "bun tools/bench/interactions-check.ts",
    "check-ops": "bun tools/bench/ops-check.ts",
    "check-relations": "bun tools/bench/relations-check.ts",
    "check-render": "bun tools/bench/shot-diff.ts check",
    "check-render-save": "bun tools/bench/shot-diff.ts save",
    "bench-model": "bun tools/bench/model-load.ts",
    "bench-edit": "bun tools/bench/edit.ts",
    "style-generate": "bun run --cwd packages/style generate",
    "lint": "oxlint --fix --fix-dangerously --deny-warnings -c oxlint.config.mjs .",
    "lint-check": "oxlint --deny-warnings -c oxlint.config.mjs .",
    "format": "oxfmt --write -c oxfmt.config.mjs .",
    "format-check": "oxfmt --check -c oxfmt.config.mjs .",
    "check-ci": "bun run --parallel type-check lint-check format-check test-run"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/bun": "^1.4.2",
    "oxfmt": "0.60.0",
    "oxlint": "1.79.0",
    "oxlint-tsgolint": "7.0.2001",
    "typescript": "^7.0.2"
  },
  "patchedDependencies": {
    "maplibre-gl@6.12.0": "patches/maplibre-gl@6.12.0.patch"
  }
}
