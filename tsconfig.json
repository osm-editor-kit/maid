{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "Preserve",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "types": ["bun"],
    "resolveJsonModule": true
  },
  "include": ["apps", "packages", "tools"],
  "references": [{ "path": "packages/model" }],
  "exclude": [
    "**/node_modules",
    "**/dist",
    ".reference",
    "packages/model",
    // these add test-only hooks and extension points to the core's global type maps:
    // checked on their own (packages/core/tsconfig.test.json) so that no other package sees them
    "packages/core/src/**/*.test.ts",
    "packages/core/src/test-fixtures.ts"
  ]
}
