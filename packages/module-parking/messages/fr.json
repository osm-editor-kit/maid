  "quick_cell_label": [
    {
      "declarations": ["input input", "input heading", "input next", "input side", "input value"],
      "selectors": ["input"],
      "match": {
        "input=touch": "{heading}, {side} : {value}. Toucher : {next}",
        "input=*": "{heading}, {side} : {value}. Clic : {next}"
      }
    }
  ],
  "quick_cell_mixed": [
    {
      "declarations": ["input input", "input heading", "input next", "input side"],
      "selectors": ["input"],
      "match": {
        "input=touch": "{heading}, {side} : différent sur les objets sélectionnés. Toucher : {next}",
        "input=*": "{heading}, {side} : différent sur les objets sélectionnés. Clic : {next}"
      }
    }
  ],
  "quick_cell_unset": [
    {
      "declarations": ["input input", "input heading", "input next", "input side"],
      "selectors": ["input"],
      "match": {
        "input=touch": "{heading}, {side} : non défini. Toucher : {next}",
        "input=*": "{heading}, {side} : non défini. Clic : {next}"
      }
    }
  ],
