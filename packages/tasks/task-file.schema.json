{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "const": "FeatureCollection"
    },
    "maid_tasks": {
      "type": "object",
      "properties": {
        "version": {
          "type": "number",
          "const": 1
        },
        "list_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._:-]{1,64}$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "description": {
          "type": "string",
          "maxLength": 10000
        }
      },
      "required": ["version", "list_id", "title", "description"],
      "additionalProperties": {}
    },
    "features": {
      "maxItems": 20000,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "const": "Feature"
          },
          "geometry": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "const": "Point"
                  },
                  "coordinates": {
                    "type": "array",
                    "prefixItems": [
                      {
                        "type": "number",
                        "minimum": -180,
                        "maximum": 180
                      },
                      {
                        "type": "number",
                        "minimum": -90,
                        "maximum": 90
                      }
                    ],
                    "items": {
                      "type": "number"
                    },
                    "minItems": 2
                  }
                },
                "required": ["type", "coordinates"],
                "additionalProperties": {}
              },
              {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "const": "LineString"
                  },
                  "coordinates": {
                    "minItems": 2,
                    "type": "array",
                    "items": {
                      "type": "array",
                      "prefixItems": [
                        {
                          "type": "number",
                          "minimum": -180,
                          "maximum": 180
                        },
                        {
                          "type": "number",
                          "minimum": -90,
                          "maximum": 90
                        }
                      ],
                      "items": {
                        "type": "number"
                      },
                      "minItems": 2
                    }
                  }
                },
                "required": ["type", "coordinates"],
                "additionalProperties": {}
              },
              {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "const": "Polygon"
                  },
                  "coordinates": {
                    "minItems": 1,
                    "type": "array",
                    "items": {
                      "minItems": 4,
                      "type": "array",
                      "items": {
                        "type": "array",
                        "prefixItems": [
                          {
                            "type": "number",
                            "minimum": -180,
                            "maximum": 180
                          },
                          {
                            "type": "number",
                            "minimum": -90,
                            "maximum": 90
                          }
                        ],
                        "items": {
                          "type": "number"
                        },
                        "minItems": 2
                      }
                    }
                  }
                },
                "required": ["type", "coordinates"],
                "additionalProperties": {}
              },
              {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "const": "MultiLineString"
                  },
                  "coordinates": {
                    "minItems": 1,
                    "type": "array",
                    "items": {
                      "minItems": 2,
                      "type": "array",
                      "items": {
                        "type": "array",
                        "prefixItems": [
                          {
                            "type": "number",
                            "minimum": -180,
                            "maximum": 180
                          },
                          {
                            "type": "number",
                            "minimum": -90,
                            "maximum": 90
                          }
                        ],
                        "items": {
                          "type": "number"
                        },
                        "minItems": 2
                      }
                    }
                  }
                },
                "required": ["type", "coordinates"],
                "additionalProperties": {}
              },
              {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "const": "MultiPolygon"
                  },
                  "coordinates": {
                    "minItems": 1,
                    "type": "array",
                    "items": {
                      "minItems": 1,
                      "type": "array",
                      "items": {
                        "minItems": 4,
                        "type": "array",
                        "items": {
                          "type": "array",
                          "prefixItems": [
                            {
                              "type": "number",
                              "minimum": -180,
                              "maximum": 180
                            },
                            {
                              "type": "number",
                              "minimum": -90,
                              "maximum": 90
                            }
                          ],
                          "items": {
                            "type": "number"
                          },
                          "minItems": 2
                        }
                      }
                    }
                  }
                },
                "required": ["type", "coordinates"],
                "additionalProperties": {}
              }
            ]
          },
          "properties": {
            "type": "object",
            "properties": {
              "task_id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9._:-]{1,64}$"
              },
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "description": {
                "type": "string",
                "maxLength": 10000
              },
              "osm": {
                "maxItems": 50,
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^(node|way|relation)\\/[1-9][0-9]*$"
                }
              },
              "links": {
                "maxItems": 20,
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "mapillary": {
                "maxItems": 20,
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[0-9]{1,20}$"
                }
              },
              "options": {
                "maxItems": 10,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9._:-]{1,64}$"
                    },
                    "label": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 200
                    },
                    "description": {
                      "type": "string",
                      "maxLength": 10000
                    },
                    "set": {
                      "type": "object",
                      "propertyNames": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 255
                      },
                      "additionalProperties": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 255
                      }
                    },
                    "remove": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 255
                      }
                    }
                  },
                  "required": ["id", "label"],
                  "additionalProperties": {}
                }
              }
            },
            "required": ["task_id", "title", "description"],
            "additionalProperties": {}
          }
        },
        "required": ["type", "geometry", "properties"],
        "additionalProperties": {}
      }
    }
  },
  "required": ["type", "maid_tasks", "features"],
  "additionalProperties": {},
  "title": "Maid task file",
  "description": "A GeoJSON FeatureCollection of map tasks for the Maid editor."
}
