# OAuth 2 client id of the app registered on the OSM development server
# (https://master.apis.dev.openstreetmap.org/oauth2/applications).
# Redirect URI of that app: http://127.0.0.1:5176/land.html
# No client secret: Maid is a public client and uses PKCE.
VITE_OSM_DEV_CLIENT_ID=

# Optional: your own Mapillary client token. Without it the apps' shared token is used
# (apps/mapillary-token.ts says where it comes from). A fork should set its own.
VITE_MAPILLARY_TOKEN=
