# OAuth 2 client id of the app registered on the OSM development server
# (https://master.apis.dev.openstreetmap.org/oauth2/applications).
# Redirect URI of that app: http://127.0.0.1:5177/land.html
# No client secret: Maid is a public client and uses PKCE.
VITE_OSM_DEV_CLIENT_ID=

# Optional: your own Mapillary client token. Without it the apps' shared token is used
# (apps/mapillary-token.ts says where it comes from). A fork should set its own.
VITE_MAPILLARY_TOKEN=

# GitHub Pages: the same client id is the repository variable OSM_DEV_CLIENT_ID, and the OAuth app's redirect
# is <your Pages URL>land.html (README, "Deploying to GitHub Pages"). There is never a client secret.

# Optional: the path the app is served from, e.g. /maid/. Unset means /, which is right for development.
# Set it in the environment of the build, not in this file: vite.config.ts reads the process environment.
# GitHub Pages builds get it from deploy.env.
VITE_BASE=

# Optional: "live" makes the build read live OSM data by default (the OSM API, read only). GitHub Pages builds
# set it. Unset means the local mock API, as in development.
VITE_MAID_DATA=
