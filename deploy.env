# Which app GitHub Pages deploys. Read by .github/workflows/pages.yml on every push to main.
# A fork changes these lines (or sets the repository variables of the same names) and leaves the workflow alone.
# Repository variables (Settings > Secrets and variables > Actions > Variables) win when they are not empty.

# One of the app folders under apps/: maid, maid-bicycle or maid-parking.
MAID_APP=maid

# The path the site is served from. Empty means /<repository name>/, e.g. /maid/ for osm-editor-kit/maid.
# A fork with its own domain at the root sets this to /
MAID_BASE=

# The OSM servers the deployed app offers, as iD's ID_API_CONNECTION: osm (openstreetmap.org), dev (the development
# server, for testing) or osm,dev. The first is the default; with one, the server choice does not show.
MAID_SERVERS=osm,dev
